# Server
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.fxv05e4.mongodb.net/fitness_tracker?appName=Cluster0

# JWT Secret (use a long, random string in production)
JWT_SECRET=your_jwt_secret_here

# Allowed frontend origin(s) — comma-separated for multiple
# e.g. https://your-app.vercel.app,http://localhost:5173
CLIENT_URL=https://your-frontend.vercel.app,http://localhost:5173
